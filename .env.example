# ============================================================
# WerkZoeker — Environment Configuration
# Kopieer dit bestand naar .env en vul je gegevens in
# ============================================================

# ── Telegram ─────────────────────────────────────────────────────────────
# Maak een bot via @BotFather op Telegram, plak het token hier
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# Jouw persoonlijk Chat ID (of groep/kanaal ID)
# Vind je via @userinfobot op Telegram
TELEGRAM_CHAT_ID=123456789

# ── Scheduler (alleen lokaal draaien) ────────────────────────────────────
# Hoe vaak scrapen in minuten (bij GitHub Actions wordt dit bepaald door de cron)
SCRAPE_INTERVAL_MINUTES=120

# Meteen een scan draaien bij opstarten?
RUN_ON_STARTUP=true

# ── Database ──────────────────────────────────────────────────────────────
DB_PATH=jobs.db

# ── Logging ──────────────────────────────────────────────────────────────
# Opties: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ── Scraper instellingen ──────────────────────────────────────────────────
# Maximum pagina's per scraper
MAX_PAGES_PER_SCRAPER=3

# Wachttijd in seconden tussen pagina's (respecteer de servers)
RATE_LIMIT_DELAY=1.5

# Request timeout in seconden
REQUEST_TIMEOUT=30

# ── Filter instellingen ───────────────────────────────────────────────────
# Minimale score om in aanmerking te komen voor een notificatie
SCORE_THRESHOLD=6

# ── Trefwoorden configuratie ──────────────────────────────────────────────
# Pad naar het trefwoorden-configuratiebestand
KEYWORDS_FILE=keywords.json

# Snelle extra trefwoorden zonder keywords.json te openen
# Formaat: trefwoord:punten,ander trefwoord:punten
# Voorbeeld: EXTRA_KEYWORDS=scada:3,plc programmeren:3
EXTRA_KEYWORDS=

# ── Startdatum filter ─────────────────────────────────────────────────────
# Maximum maanden vooruit dat een opdracht mag beginnen (leeg = geen filter)
# Voorbeeld: 6 = alleen opdrachten die binnen 6 maanden starten
MAX_START_MONTHS_AHEAD=6

# Als true: opdrachten zonder startdatum worden altijd doorgelaten (aanbevolen)
INCLUDE_UNKNOWN_START_DATE=true

# Als true: opdrachten met een startdatum in het verleden worden ook meegenomen
INCLUDE_ALREADY_STARTED=true
